# Copy to server/.env and adjust. Never commit the real .env.
PORT=4000
# Matches docker-compose.yml. Change if you use your own PostgreSQL.
DATABASE_URL=postgres://sweety:sweety@localhost:5432/sweety
# Used only by `npm test`. It is wiped between tests, so keep it separate from DATABASE_URL.
TEST_DATABASE_URL=postgres://sweety:sweety@localhost:5432/sweety_test
# Generate one: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Must be at least 32 characters in production.
JWT_SECRET=replace-me-with-a-long-random-string
# IANA timezone used to decide what "today" and "future" mean.
APP_TIMEZONE=Asia/Kolkata
